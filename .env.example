# 浏览器访问本实例的完整地址；更换域名或端口时同步修改。
APP_URL=http://localhost:8000
# 默认仅允许本机访问；局域网部署可改为 0.0.0.0，公网使用自己的 HTTPS 反向代理。
BIND_ADDRESS=127.0.0.1
# 本机访问端口；更改时同时修改 APP_URL。
HTTP_PORT=8000
# 内部数据库密码；首次安装前可修改，已有数据卷时不要直接修改。
# 数据库不向宿主机开放端口。此默认值仅用于本机部署。
DB_PASSWORD=yanji-local-database
# 队列重派等待秒数，必须大于所有任务的超时（当前最长 540 秒）。
DB_QUEUE_RETRY_AFTER=600
# 可选：本机或内网模型服务的精确主机名:端口，多个用逗号分隔。
# 默认留空，继续拦截内网请求；仅填写自己控制的模型服务，不支持通配符。
GEO_OUTBOUND_PRIVATE_TARGETS=
# 可选：部署者授权的 Magpie 目标，按工作区 ID 绑定。以下为字段示例。
# GEO_MAGPIE_TARGETS='{"local":{"origin":"http://127.0.0.1:3425","tenant_ids":[1],"auth_mode":"loopback","enabled":true,"revision":1}}'
# Docker Desktop 使用 host.docker.internal 和 gateway_key。Gateway Key 在网页中填写。
# 其他 DNS 主机名需提供 addresses 数组，列出允许的精确本机 IP。
# 撤销可达目标时保留条目并设 enabled=false；变更授权后更新 revision。
GEO_MAGPIE_TARGETS=
# 显示分析面板。
GEO_ANALYTICS_PANEL_ENABLED=true
# 显示队列健康面板。
GEO_QUEUE_HEALTH_PANEL_ENABLED=true
# 显示监测入口，未填写豆包 Key 时提示未配置。
GEO_VISIBILITY_PANEL_ENABLED=true
# 开启手动发布流程。
GEO_MANUAL_PUBLISH_ENABLED=true
# 开启知乎草稿助手；关闭后仍可使用人工发布流程。
GEO_ZHIHU_DRAFT_SYNC_ENABLED=true
# 开启线索表单。
GEO_LEAD_FORM_ENABLED=true
# 开启主题包生成入口。
GEO_THEME_PACKAGE_ENABLED=true
# 显示视觉功能入口，未配置视觉模型时提示未配置。
GEO_KNOWLEDGE_VISION=true
# 可选：部署者提供的用户协议完整网址；留空不显示。
YANJI_TERMS_URL=
# 可选：部署者提供的隐私政策完整网址；留空不显示。
YANJI_PRIVACY_URL=
# 可选：部署者的网站完整网址；留空不显示。
YANJI_WEBSITE_URL=
# APP_KEY 由初始化命令生成，保存在 instance 数据卷；不要自行重建或修改。
# 模型 Key 仅在登录后的设置页填写，不写入本文件。
