# 安装器为每个实例生成 APP_KEY、独立的会话 Cookie 名，以及数据库文件的绝对路径。
APP_ENV=production
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_KEY=
DB_CONNECTION=sqlite
DB_DATABASE=
DB_SQLITE_JOURNAL_MODE=WAL
DB_SQLITE_BUSY_TIMEOUT=5000
DB_SQLITE_TRANSACTION_MODE=IMMEDIATE
GEO_RAG_REQUIRE_PGVECTOR_IN_PRODUCTION=false
GEO_RAG_SQLITE_FALLBACK_ENABLED=true
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=600
SESSION_DRIVER=file
SESSION_COOKIE=
CACHE_STORE=file
GEO_OUTBOUND_PRIVATE_TARGETS=
GEO_MAGPIE_TARGETS=
GEO_ANALYTICS_PANEL_ENABLED=true
GEO_QUEUE_HEALTH_PANEL_ENABLED=true
GEO_VISIBILITY_PANEL_ENABLED=true
GEO_MANUAL_PUBLISH_ENABLED=true
GEO_ZHIHU_DRAFT_SYNC_ENABLED=true
GEO_LEAD_FORM_ENABLED=true
GEO_KNOWLEDGE_VISION=true
YANJI_TERMS_URL=
YANJI_PRIVACY_URL=
YANJI_WEBSITE_URL=
