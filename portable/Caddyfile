{
    admin off
    auto_https off
    skip_install_trust
    frankenphp
}

http://127.0.0.1:{$YANJI_PORT} {
    bind 127.0.0.1
    root * {env.YANJI_PUBLIC_PATH}
    encode zstd br gzip
    header -Server

    route {
        @upgradeHold {
            not path /up
            file {
                root {env.YANJI_ENV_PATH}/run
                try_files upgrade-hold
            }
        }
        respond @upgradeHold 503
        @privateReports path /storage/executions /storage/executions/* /storage/analysis /storage/analysis/*
        respond @privateReports 404
        php_server
    }
}
